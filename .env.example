# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Public App Store / in-app policy destinations.
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_SUPPORT_URL=

# Keep false for the current visual preview.
# Set true after migrations, memberships and account-deletion testing are complete.
NEXT_PUBLIC_AUTH_REQUIRED=false
