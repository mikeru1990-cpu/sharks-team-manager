# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=

# Public App Store / in-app policy destinations.
NEXT_PUBLIC_PRIVACY_POLICY_URL=
NEXT_PUBLIC_SUPPORT_URL=

# Keep false for the current visual preview.
# Set true after migrations, memberships and account-deletion testing are complete.
NEXT_PUBLIC_AUTH_REQUIRED=false

# Release-validation only. Keep these in the GitHub Actions
# 'release-validation' environment or a private local .env file.
# Never expose passwords through NEXT_PUBLIC_* variables.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
FOOTBALL_OS_TEST_TEAM_ID=
FOOTBALL_OS_OTHER_TEAM_ID=
FOOTBALL_OS_COACH_EMAIL=
FOOTBALL_OS_COACH_PASSWORD=
FOOTBALL_OS_ASSISTANT_EMAIL=
FOOTBALL_OS_ASSISTANT_PASSWORD=
FOOTBALL_OS_PARENT_EMAIL=
FOOTBALL_OS_PARENT_PASSWORD=
